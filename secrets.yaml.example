# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is git-ignored and never committed.

# Your 2.4 GHz Wi-Fi network credentials
wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"

# Fallback access point password (used if Wi-Fi can't connect at boot)
# Any 8+ character string.
fallback_ap_password: "change-me-fallback"

# Home Assistant API encryption key.
# Generate a new one with:  openssl rand -base64 32
api_encryption_key: "REPLACE-WITH-32-BYTE-BASE64-KEY=="

# OTA update password. Any 8+ character string.
ota_password: "change-me-ota"
